{
  "name": "smtp-tester",
  "version": "1.0.7",
  "description": "Batch-test bulk SMTP credentials: live/dead, valid, and inbox/spam placement via your own seed mailboxes.",
  "author": "SMTP Tester",
  "type": "module",
  "main": "src/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test",
    "dev": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "issue-license": "node scripts/issue-license.js",
    "bot": "node scripts/telegram-bot.js"
  },
  "dependencies": {
    "electron-store": "^10.0.0",
    "electron-updater": "^6.8.11",
    "imapflow": "^1.0.164",
    "nodemailer": "^6.9.16",
    "socks": "^2.8.10",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "smtp-server": "^3.13.6"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "com.smtp-tester.app",
    "productName": "SMTP Tester",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "python/**/*",
      "package.json",
      "!python/.venv/**",
      "!python/dist/**",
      "!tests/**",
      "!scripts/**",
      "!telegram-bot-vercel/**",
      "!**/*.test.js",
      "!**/*.md"
    ],
    "asarUnpack": [
      "python/**"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asar": false
  }
}
